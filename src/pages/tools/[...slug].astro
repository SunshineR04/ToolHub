---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map(t => ({ params: { slug: t.slug } }));
}

const { slug } = Astro.params;
const tool = await getEntry('tools', slug!);

if (!tool) {
  return Astro.redirect('/');
}

const { name, url, description, icon, category, tags, downloads } = tool.data;
---

<BaseLayout>
  <div class="max-w-2xl mx-auto py-8">
    <a href="/" class="text-sm text-primary-600 hover:text-primary-700 mb-6 inline-block">&larr; 返回首页</a>

    <div class="bg-white rounded-2xl border border-gray-100 p-8">
      <div class="flex items-start gap-4 mb-6">
        <span class="text-5xl">{icon}</span>
        <div>
          <h1 class="text-2xl font-bold text-gray-900">{name}</h1>
          <span class="inline-block mt-1 text-sm px-3 py-1 rounded-full bg-primary-50 text-primary-600 font-medium">
            {category}
          </span>
        </div>
      </div>

      <p class="text-gray-600 leading-relaxed mb-6">{description}</p>

      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-6">
          {tags.map(tag => (
            <span class="text-xs px-2.5 py-1 rounded bg-gray-100 text-gray-500">{tag}</span>
          ))}
        </div>
      )}

      {
        downloads.length > 0 && (
          <div class="border-t pt-6 mb-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">下载</h2>
            <div class="space-y-3">
              {downloads.map(dl => {
                const href = dl.file || dl.url;
                if (!href) return null;
                return (
                  <a
                    href={href}
                    download={dl.file ? dl.name : undefined}
                    class="flex items-center gap-3 px-4 py-3 bg-gray-50 rounded-xl border border-gray-200 hover:border-primary-300 hover:bg-primary-50 transition-colors group"
                  >
                    <svg class="w-5 h-5 text-gray-400 group-hover:text-primary-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                    </svg>
                    <span class="text-sm font-medium text-gray-700 group-hover:text-primary-600 flex-1">{dl.name}</span>
                    {dl.file && (
                      <span class="text-xs text-gray-400 bg-white px-2 py-1 rounded border">
                        {dl.file.split('.').pop()?.toUpperCase()}
                      </span>
                    )}
                  </a>
                );
              })}
            </div>
          </div>
        )
      }

      {url && (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 bg-primary-600 text-white rounded-xl font-medium hover:bg-primary-700 transition-colors"
        >
          访问网站
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      )}
    </div>
  </div>
</BaseLayout>
